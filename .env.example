MONGODB_URI=mongodb://localhost:27017/codecoach
# Enables the AI tutor. Hints work without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# browser | docker | disabled
CODE_RUNNER=browser
CLIENT_ORIGIN=http://localhost:5173
